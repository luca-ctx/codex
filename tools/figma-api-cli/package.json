    "otplib": "^12.0.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "undici": "6.19.8",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=18"
  }
}
