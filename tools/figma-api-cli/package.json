{
  "name": "@icp/figma-api-cli",
  "version": "0.1.0",
  "description": "Figma MCP HTTP CLI for deterministic design context retrieval.",
  "type": "module",
  "bin": {
    "figma-api": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "prepare": "pnpm run build",
    "cli": "node dist/index.js",
    "test": "vitest run"
  },
  "keywords": [
